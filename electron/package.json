{
  "name": "workpulse-desktop",
  "productName": "WorkPulse",
  "version": "1.0.13",
  "description": "WorkPulse desktop app",
  "main": "main.cjs",
  "private": true,
  "scripts": {
    "dist": "node ../scripts/electron-builder.mjs",
    "pack": "node ../scripts/electron-builder.mjs --dir"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "local.workpulse.desktop",
    "productName": "WorkPulse",
    "directories": {
      "output": "release"
    },
    "files": [
      "*.cjs",
      "icon.png",
      "app/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "generic",
        "url": "http://127.0.0.1:38418"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "allowScripts": {
    "electron@39.8.10": true
  }
}
